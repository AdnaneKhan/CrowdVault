# Leave VITE_CHAIN_ID empty to let visitors choose Ethereum or Sepolia, with
# built-in public RPCs. Set it (e.g. 1, 8453, 11155111) to serve that one chain.
# Transactions are refused on any other network.
VITE_CHAIN_ID=

# With VITE_CHAIN_ID: your CrowdVaultFactory on that chain. The page only shows
# vaults it created; without it, it warns that it can't confirm a vault is genuine.
VITE_FACTORY_ADDRESS=
# Without VITE_CHAIN_ID: your factories on each network, for the same check.
VITE_FACTORY_MAINNET=
VITE_FACTORY_SEPOLIA=

# Optional, with VITE_CHAIN_ID: read-only RPC for that chain, so visitors
# without a wallet can see the vault. Ethereum and Sepolia have public defaults.
VITE_RPC_URL=
# Optional: default vault address (otherwise pass ?vault=0x... in the URL).
VITE_VAULT_ADDRESS=
# Optional: set to 1 to offer a "Demo mode" button with a pretend vault.
VITE_DEMO_BUTTON=
