# The chain this page serves, e.g. 1 (Ethereum), 8453 (Base), 11155111 (Sepolia).
# Transactions are refused on any other network.
VITE_CHAIN_ID=
# Your CrowdVaultFactory. The page only shows vaults it created. Without it, the
# page shows a warning that it can't confirm a vault is genuine.
VITE_FACTORY_ADDRESS=
# Optional: read-only RPC for this chain, so visitors without a wallet can see the vault.
VITE_RPC_URL=
# Optional: default vault address (otherwise pass ?vault=0x... in the URL).
VITE_VAULT_ADDRESS=
